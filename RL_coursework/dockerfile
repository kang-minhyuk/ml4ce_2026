FROM quay.io/jupyter/minimal-notebook:python-3.12

USER root

ENV COURSE_ROOT=/opt/course \
    COURSE_OUTPUT_DIR=/home/jovyan/work/outputs \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLCONFIGDIR=/tmp/matplotlib

WORKDIR /opt/course/source

# The environment/helpers package is installed read-only, outside the student workspace.
COPY pyproject.toml ./
COPY course_package/ ./course_package/

# CPU-only torch (no GPU is used; the default wheel pulls several GB of CUDA libraries).
# Keep the version in sync with benchmark/Dockerfile.grader.
RUN pip install --no-cache-dir uv \
    && uv pip install --system "torch==2.14.0" --index-url https://download.pytorch.org/whl/cpu \
    && uv pip install --system .

# Pristine copies of the student-facing files, used to seed an empty workspace.
COPY README.md /opt/course/templates/README.md
COPY RL_coursework.ipynb /opt/course/templates/RL_coursework.ipynb
COPY algorithms/ /opt/course/templates/algorithms/
COPY data/training/ /opt/course/templates/data/training/

COPY docker-entrypoint.sh /usr/local/bin/course-entrypoint

RUN chmod +x /usr/local/bin/course-entrypoint \
    && chown -R root:root /opt/course \
    && chmod -R a-w /opt/course \
    && mkdir -p /home/jovyan/work/data/training \
    && mkdir -p /home/jovyan/work/outputs \
    && chown -R "${NB_UID}:${NB_GID}" /home/jovyan/work

# Initialise bind mounts as root, then let the base image drop privileges
# before Jupyter starts.
USER root

# Jupyter only serves /home/jovyan/work: notebook, algorithms/, data/ and outputs/.
WORKDIR /home/jovyan/work

EXPOSE 8888

ENTRYPOINT ["course-entrypoint"]

CMD ["jupyter", "lab", \
    "--ip=0.0.0.0", \
    "--no-browser", \
    "--IdentityProvider.token=", \
    "--FileContentsManager.use_atomic_writing=False", \
    "--ServerApp.root_dir=/home/jovyan/work"]
